#!/bin/sh
# Cancela el push si src/ no compila: así una rama rota no llega a GitHub ni a un PR.
# Se activa una vez por clon con: git config core.hooksPath .githooks
# Ojo: compila los archivos del disco, no exactamente el commit que se sube.

if ! command -v javac >/dev/null 2>&1; then
    echo "pre-push: no se encontró javac en el PATH; no se verifica la compilación." >&2
    exit 0
fi

raiz=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d)
find "$raiz/src" -name "*.java" > "$tmp/sources.txt"
javac -encoding UTF-8 -d "$tmp/out" @"$tmp/sources.txt"
resultado=$?
rm -rf "$tmp"

if [ $resultado -ne 0 ]; then
    echo "" >&2
    echo "No compila: push cancelado. Corrige los errores de arriba y vuelve a hacer push." >&2
    exit 1
fi
